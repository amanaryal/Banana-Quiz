# Purpose: Shows which environment variables the server needs, without real secrets.
# Theme: Version control (and later virtual identity / interoperability)
# Portions generated with AI assistance (Cursor) - reviewed and understood by the author.
#
# HOW TO USE:
# 1. Copy this file to server/.env
# 2. Replace the placeholder values with your own
# 3. Never commit server/.env (it is listed in .gitignore)

# Port the Express server listens on
PORT=5000

# MongoDB connection string (local example). Change the database name if you want.
MONGO_URI=mongodb://127.0.0.1:27017/banana-quiz

# Secret used to sign login tokens. Use a long random string. Do not use this example value.
JWT_SECRET=replace-with-a-long-random-string

# Address of the React app, so the server can allow browser requests from it (CORS)
CLIENT_ORIGIN=http://localhost:5173
